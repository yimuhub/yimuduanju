{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YIMU",
  "version": "3.7.2",
  "identifier": "com.yimu.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../dist/client",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一幕·YIMU AI 短剧创作平台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "一幕·YIMU AI 短剧创作平台桌面端",
    "longDescription": "从一句话创意到成片的 AI 短剧 / AI 漫剧全流程创作平台。v0 壳加载本机网关 http://127.0.0.1:5173，需先运行 ./scripts/start.sh。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
