# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 本地运行数据（不进仓库）
# 注意：必须用前导斜杠锚定仓库根，否则 "data/" 会把源码目录 client/src/data/ 一并排除，
# 导致新 clone / 新 worktree 缺少 styleLibrary 等前端常量而构建失败。
/data/
/data-test/
logs/
backups/
uploads/
dump.rdb

# WorkBuddy 项目记忆（本地协作数据，不进仓库）
.workbuddy/

# 真实密钥（绝不提交；示例文件除外）
# 注意：必须用 .env.* 通配，否则 .env.enterprise 这类真实密钥文件会被提交。
# 下面两条 ! 例外规则必须保持在最后，才能让示例模板正常进仓库。
.env
.env.*
!.env.example
!.env.enterprise.example

# 系统文件
.DS_Store
*.log

# 编辑器
.vscode/
.idea/
*.swp

# AI 生成封面的原始大图（本地留存，交付产物是 client/public/styles/*.webp）
/vibe_images/styles-2026-11-12/
/vibe_images/lib-styles-2026-11-12/

/build/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/.tauri-cache/
/release/
