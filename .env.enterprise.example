# =============================================================================
# 一幕·YIMU AI 短剧工坊 —— 企业版部署环境变量示例
# 用法：cp .env.enterprise.example .env.enterprise，然后按实际情况填写每一项。
# 注意：真实的 .env.enterprise 切勿提交到 git（已在 .gitignore 忽略）。
# =============================================================================

# 数据库连接串（PostgreSQL 16；用户/密码/库名按实际部署改）
DATABASE_URL=postgres://yimu:CHANGE_ME@localhost:5432/yimu

# Redis 连接串（任务队列用；不填则网关/后端降级为进程内串行模式）
REDIS_URL=redis://localhost:6379

# 网关监听端口（本地一键启动默认 5173，企业版可改）
PORT=5173

# 管理接口调用令牌（W4 鉴权接入后用于保护 /api/billing/*、/api/admin/* 等接口；
# 生成方式：openssl rand -hex 32；部署后请妥善保管，不要写进文档）
ADMIN_API_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Key 落库加密密钥（W1 鉴权/加密接入后用于加密 provider api_key 等字段；
# 长度建议 32 字节以上 hex，丢失则已加密的 Key 无法解密，请备份）
YIMU_KEY_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# 运行模式（企业版固定 production；不要用 development）
NODE_ENV=production

# 网关绑定地址（默认只绑本机回环，防止局域网/公网直接访问；
# 如确需对外提供服务，改成 0.0.0.0 并务必在前置加反向代理 + 鉴权）
GATEWAY_HOST=127.0.0.1

# =============================================================================
# 以下为 Docker Compose 企业栈（deploy/docker-compose.yml）专用变量。
# 用法：docker compose -f deploy/docker-compose.yml --env-file .env.enterprise up -d --build
# compose 会从这些变量拼出 SUDA_DATABASE_URL / REDIS_URL，不再读上面的 DATABASE_URL。
# =============================================================================

# postgres 容器初始化（首次启动生效；改密码后需删卷重建）
DB_NAME=yimu
DB_USER=yimu
DB_PASSWORD=CHANGE_ME_务必修改

# compose 对外映射端口（容器内固定 3000）
SERVER_PORT=3000

# 企业版管理令牌（对应文档「三、管理接口」x-admin-token；未配置则管理接口整体 401）
ENTERPRISE_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# 企业版授权（对应文档「二、License」；不填为社区模式，功能全开）
ENTERPRISE_LICENSE=
LICENSE_SECRET=CHANGE_ME_签发密钥

# 月度预算上限（元；留空=不限，对应 MONTHLY_BUDGET_CAP_CNY）
MONTHLY_BUDGET_CAP_CNY=
