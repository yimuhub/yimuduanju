# 一幕·YIMU 服务端镜像（W6 企业版 1.0）
# 构建（含前端产物，ViewModule 直接伺服）：docker build -f deploy/Dockerfile.server -t yimu-server .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --ignore-scripts
COPY . ./
RUN NODE_ENV=production npx nest build
RUN NODE_ENV=production npx vite build --config vite.config.ts

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm install --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/server/database/migrations ./server/database/migrations
EXPOSE 3000
CMD ["sh", "-c", "node scripts/migrate.js && node dist/server/main.js"]
