    "typescript-eslint": "^8.44.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "zustand": "~5.0.8"
  },
  "overrides": {
    "dayjs": "^1.11.15"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/server/**/*.spec.ts",
      "<rootDir>/test/unit/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json",
          "diagnostics": false
        }
      ]
    },
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@server/(.*)$": "<rootDir>/server/$1"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}