{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YIMU",
  "version": "3.7.3",
  "identifier": "com.yimu.desktop",
  "build": {
    "frontendDist": "../../desktop/splash",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 一幕 YIMU",
    "publisher": "一幕 YIMU",
    "shortDescription": "一幕·YIMU AI 短剧创作平台",
    "longDescription": "从一句话创意到成片的 AI 短剧 / AI 漫剧全流程创作平台。安装包内置 Node 运行时、PostgreSQL 与 ffmpeg，开包即用，无需另装环境；数据保存在本机应用数据目录。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/desktop-app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
